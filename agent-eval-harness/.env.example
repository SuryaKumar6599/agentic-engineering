# ── Local model (Ollama / LM Studio / llama.cpp) ───────────────────────────────
# Set LOCAL_MODEL_BASE_URL to the OpenAI-compatible endpoint of your local server:
#   Ollama:      http://localhost:11434/v1
#   LM Studio:   http://localhost:1234/v1
#   llama.cpp:   http://localhost:8080/v1
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
# API key is ignored by local servers but required by the openai SDK (use any string)
LOCAL_MODEL_API_KEY=ollama

# Model identifier as registered in your local server:
#   Ollama:    qwen3:30b-a3b-ud-q2_k_xl
#   LM Studio: use the model name shown in the LM Studio UI
LOCAL_MODEL_NAME=qwen3:30b-a3b-ud-q2_k_xl

# ── Cloud LLM providers (optional – only needed for cloud-based judge/comparison) ──
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Langfuse observability ──────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL

# ── Eval model (used by DeepEval + Ragas as judge) ─────────────────────────────
# Set to "local" to route the judge through your LOCAL_MODEL_* settings above.
EVAL_MODEL=local                            # "local" → Qwen3 | or any OpenAI model name
EVAL_MAX_CONCURRENCY=2                      # keep low for local GPU/CPU inference

# ── Cost budget (USD) per CI run ───────────────────────────────────────────────
# Local inference has zero token cost – set high or disable with 9999
COST_BUDGET_USD=9999.00

# ── Latency thresholds (seconds) ───────────────────────────────────────────────
# Local quantised models are slower per token; widen the budget accordingly
LATENCY_P95_MAX_S=60.0
LATENCY_P99_MAX_S=120.0
